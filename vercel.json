{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "installCommand": "npm install --legacy-peer-deps",
  "crons": [
    {
      "path": "/api/admin/digest/trigger",
      "schedule": "30 3 * * 1-5"
    },
    {
      "path": "/api/admin/email-outbox/process",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/streak-tick",
      "schedule": "30 13 * * 1-5"
    }
  ]
}
