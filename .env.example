# ================================================================
# Receivables Ageing Dashboard — Environment Variables
# ----------------------------------------------------------------
# Copy to `.env` for local dev. DO NOT commit the real `.env`.
# Production values live in Railway project settings.
# ================================================================

# ---- App ----
APP_ENV=development                 # development | staging | production
APP_NAME=receivables-ageing-dashboard
APP_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
APP_BASE_URL=http://localhost:8000  # used in email links

# ---- Database (Neon Postgres — serverless) ----
# See ADR-0002 for the D21 deviation (Neon instead of Railway Postgres add-on).
# Get the connection string from the Neon dashboard → Connection Details.
# Copy the "SQLAlchemy" variant and prepend `+psycopg` to the driver:
#   postgres://USER:PASS@HOST/DB?sslmode=require
#   → postgresql+psycopg://USER:PASS@HOST/DB?sslmode=require
# Prefer a pooled (pgbouncer) connection for app runtime; use the direct
# (unpooled) one for `alembic upgrade` migrations.
DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx-pooler.region.aws.neon.tech/receivables?sslmode=require
DATABASE_URL_DIRECT=postgresql+psycopg://user:password@ep-xxxx.region.aws.neon.tech/receivables?sslmode=require

# ---- Session / cookies ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=replace-me-with-64-char-random-string
SESSION_MAX_AGE_SECONDS=43200       # 12h idle per spec §11
SESSION_COOKIE_SECURE=false         # true in production (HTTPS)

# ---- Google Workspace SSO (D4) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_DOMAIN=emb.global
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---- Email provider (D22: Resend or SendGrid) ----
# Decide at first deploy. Set one, leave the other blank.
EMAIL_PROVIDER=resend               # resend | sendgrid
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_FROM_ADDRESS=receivables-bot@emb.global
SMTP_FROM_NAME=EMB Receivables

# ---- Scheduler ----
# Daily CFO digest: IST 09:00 → UTC 03:30
DIGEST_CRON_UTC="30 3 * * 1-5"
SCHEDULER_TIMEZONE=UTC

# ---- FX / misc ----
# Nothing to set here — FX rates are admin-managed via UI (A4).

# ---- Object storage (optional — retained uploads) ----
# Start with Railway volume; switch to S3 if/when needed.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=60
