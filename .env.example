# Receivables Ageing Dashboard - Next.js / Neon / Prisma
# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Receivables Ageing Dashboard
NEXT_PUBLIC_API_URL=http://localhost:3000

# Neon Postgres
# Runtime should use the pooled Neon URL. Prisma CLI/migrations can use direct.
DATABASE_ADAPTER=neon
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/receivables?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxxx.region.aws.neon.tech/receivables?sslmode=require

# Fully local Postgres development can override these values in ignored
# .env.local:
# DATABASE_ADAPTER=pg
# DATABASE_URL=postgresql://receivables:receivables@127.0.0.1:5433/receivables?schema=public
# DATABASE_URL_DIRECT=postgresql://receivables:receivables@127.0.0.1:5433/receivables?schema=public

# Local auth
# development/stub enables the local stub admin flow. Use google in production.
AUTH_PROVIDER=development
SESSION_SECRET=replace-me-with-at-least-64-random-characters

# Google Workspace SSO
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_DOMAIN=emb.global
NEXTAUTH_URL=http://localhost:3000

# Email delivery, still gated before production activation
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_FROM_ADDRESS=receivables-bot@emb.global
SMTP_FROM_NAME=EMB Receivables

# Object storage for retained source uploads before production cutover
# For Cloudflare R2 or other S3-compatible storage, set S3_ENDPOINT to the
# account endpoint, for example https://<account-id>.r2.cloudflarestorage.com.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Vercel Cron authentication
# Must match the CRON_SECRET set in the Vercel project dashboard.
# Vercel sends Authorization: Bearer <CRON_SECRET> on every cron invocation.
# If unset in production, the daily digest cron will fail with 401.
CRON_SECRET=
# Optional: a users.id UUID to attribute cron-triggered digest events in audit log.
# If unset, cron-triggered events will have no actor_user_id.
CRON_ACTOR_USER_ID=
